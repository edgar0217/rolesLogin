<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Dashboard | Mi Sistema</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-50 text-gray-900">

  <!-- NAVBAR -->
  <header class="border-b border-gray-200 bg-white">

    <nav
      class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4"
    >

      <div class="flex items-center gap-8">

        <a
          href="/dashboard"
          class="text-xl font-bold text-gray-900"
        >
          Mi Sistema
        </a>

        <div class="hidden items-center gap-6 md:flex">

          <a
            href="/dashboard"
            class="text-sm font-medium text-blue-600"
          >
            Inicio
          </a>

          <a
            href="/recetas"
            class="text-sm font-medium text-gray-600 hover:text-blue-600"
          >
            Recetas
          </a>

        </div>

      </div>


      <div class="flex items-center gap-4">

        <div class="hidden text-right sm:block">

          <p class="text-sm font-semibold text-gray-900">
            <%= user.nombre %>
          </p>

          <p class="text-xs text-gray-500">
            <%= user.correo %>
          </p>

        </div>


        <a
          href="/logout"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100"
        >
          Cerrar sesión
        </a>

      </div>

    </nav>

  </header>


  <main class="mx-auto max-w-7xl px-6 py-10">

    <!-- BIENVENIDA -->
    <section
      class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm"
    >

      <span
        class="inline-block rounded-full bg-blue-100 px-4 py-2 text-sm font-medium text-blue-700"
      >
        Dashboard
      </span>


      <h1
        class="mt-5 text-3xl font-bold tracking-tight text-gray-900"
      >
        Bienvenido, <%= user.nombre %>
      </h1>


      <p class="mt-3 max-w-2xl text-gray-600">
        Explora las recetas disponibles y encuentra nuevas
        ideas para preparar.
      </p>

    </section>


    <!-- ACCESOS -->
    <section class="mt-8 grid gap-6 md:grid-cols-3">

      <a
        href="/recetas"
        class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
      >

        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-xl"
        >
          🍽️
        </div>

        <h2 class="mt-5 text-lg font-bold">
          Ver recetas
        </h2>

        <p class="mt-2 text-sm leading-6 text-gray-600">
          Consulta todas las recetas disponibles.
        </p>

      </a>


      <div
        class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm"
      >

        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-green-100 text-xl"
        >
          🥗
        </div>

        <h2 class="mt-5 text-lg font-bold">
          Categorías
        </h2>

        <p class="mt-2 text-sm leading-6 text-gray-600">
          Próximamente podrás explorar recetas por categoría.
        </p>

      </div>


      <div
        class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm"
      >

        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-yellow-100 text-xl"
        >
          ⭐
        </div>

        <h2 class="mt-5 text-lg font-bold">
          Favoritos
        </h2>

        <p class="mt-2 text-sm leading-6 text-gray-600">
          Próximamente podrás guardar tus recetas favoritas.
        </p>

      </div>

    </section>


    <!-- RECETAS RECIENTES -->
    <section class="mt-12">

      <div class="flex items-center justify-between">

        <div>

          <h2 class="text-2xl font-bold text-gray-900">
            Recetas recientes
          </h2>

          <p class="mt-2 text-sm text-gray-600">
            Descubre algunas recetas disponibles.
          </p>

        </div>


        <a
          href="/recetas"
          class="text-sm font-semibold text-blue-600 hover:text-blue-700"
        >
          Ver todas →
        </a>

      </div>


      <% if (recetas.length === 0) { %>

        <div
          class="mt-6 rounded-2xl border border-dashed border-gray-300 bg-white p-12 text-center"
        >

          <p class="text-gray-500">
            Todavía no hay recetas disponibles.
          </p>

        </div>

      <% } else { %>

        <div
          class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
        >

          <% recetas.forEach((receta) => { %>

            <article
              class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md"
            >

              <% if (receta.imagen_url) { %>

                <img
                  src="<%= receta.imagen_url %>"
                  alt="<%= receta.nombre %>"
                  class="h-52 w-full object-cover"
                />

              <% } else { %>

                <div
                  class="flex h-52 items-center justify-center bg-gray-100 text-gray-400"
                >
                  Sin imagen
                </div>

              <% } %>


              <div class="p-6">

                <span
                  class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700"
                >
                  <%= receta.categoria %>
                </span>


                <h3
                  class="mt-4 text-xl font-bold text-gray-900"
                >
                  <%= receta.nombre %>
                </h3>


                <p
                  class="mt-2 line-clamp-2 text-sm leading-6 text-gray-600"
                >
                  <%= receta.descripcion %>
                </p>


                <div
                  class="mt-5 flex items-center justify-between"
                >

                  <% if (receta.tiempo_preparacion) { %>

                    <span class="text-sm text-gray-500">
                      ⏱ <%= receta.tiempo_preparacion %> min
                    </span>

                  <% } %>


                  <a
                    href="/recetas/<%= receta.id_receta %>"
                    class="text-sm font-semibold text-blue-600 hover:text-blue-700"
                  >
                    Ver receta →
                  </a>

                </div>

              </div>

            </article>

          <% }) %>

        </div>

      <% } %>

    </section>

  </main>


  <footer
    class="mt-16 border-t border-gray-200 bg-white"
  >

    <div
      class="mx-auto max-w-7xl px-6 py-6 text-center text-sm text-gray-500"
    >
      &copy; <%= new Date().getFullYear() %>
      Mi Sistema. Todos los derechos reservados.
    </div>

  </footer>

</body>
</html>