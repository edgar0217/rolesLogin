<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Recetas | Mi Sistema</title>

  <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="min-h-screen bg-gray-50 text-gray-900">

  <header class="border-b border-gray-200 bg-white">

    <nav
      class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4"
    >

      <a
        href="/dashboard"
        class="text-xl font-bold"
      >
        Mi Sistema
      </a>


      <div class="flex items-center gap-6">

        <a
          href="/dashboard"
          class="text-sm font-medium text-gray-600 hover:text-blue-600"
        >
          Inicio
        </a>

        <a
          href="/recetas"
          class="text-sm font-medium text-blue-600"
        >
          Recetas
        </a>

        <a
          href="/logout"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-100"
        >
          Cerrar sesión
        </a>

      </div>

    </nav>

  </header>


  <main class="mx-auto max-w-7xl px-6 py-12">

    <div>

      <span
        class="rounded-full bg-blue-100 px-4 py-2 text-sm font-medium text-blue-700"
      >
        Recetario
      </span>

      <h1
        class="mt-5 text-4xl font-bold tracking-tight"
      >
        Todas las recetas
      </h1>

      <p class="mt-3 text-gray-600">
        Explora las recetas disponibles.
      </p>

    </div>


    <% if (recetas.length === 0) { %>

      <div
        class="mt-10 rounded-2xl border border-dashed border-gray-300 bg-white p-12 text-center"
      >

        <p class="text-gray-500">
          No hay recetas disponibles.
        </p>

      </div>

    <% } else { %>

      <div
        class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      >

        <% recetas.forEach((receta) => { %>

          <article
            class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md"
          >

            <% if (receta.imagen_url) { %>

              <img
                src="<%= receta.imagen_url %>"
                alt="<%= receta.nombre %>"
                class="h-56 w-full object-cover"
              />

            <% } else { %>

              <div
                class="flex h-56 items-center justify-center bg-gray-100 text-gray-400"
              >
                Sin imagen
              </div>

            <% } %>


            <div class="p-6">

              <div class="flex items-center justify-between">

                <span
                  class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700"
                >
                  <%= receta.categoria %>
                </span>

                <span class="text-xs text-gray-500">
                  <%= receta.dificultad %>
                </span>

              </div>


              <h2
                class="mt-4 text-xl font-bold"
              >
                <%= receta.nombre %>
              </h2>


              <p
                class="mt-2 line-clamp-3 text-sm leading-6 text-gray-600"
              >
                <%= receta.descripcion %>
              </p>


              <div
                class="mt-6 flex items-center justify-between"
              >

                <% if (receta.tiempo_preparacion) { %>

                  <span class="text-sm text-gray-500">
                    ⏱ <%= receta.tiempo_preparacion %> min
                  </span>

                <% } %>


                <a
                  href="/recetas/<%= receta.id_receta %>"
                  class="text-sm font-semibold text-blue-600 hover:text-blue-700"
                >
                  Ver detalles →
                </a>

              </div>

            </div>

          </article>

        <% }) %>

      </div>

    <% } %>

  </main>

</body>

</html>