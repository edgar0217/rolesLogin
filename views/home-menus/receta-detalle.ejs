<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    <%= receta.nombre %> | Mi Sistema
  </title>

  <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="min-h-screen bg-gray-50 text-gray-900">

  <header class="border-b border-gray-200 bg-white">

    <nav
      class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4"
    >

      <a
        href="/dashboard"
        class="text-xl font-bold"
      >
        Mi Sistema
      </a>


      <div class="flex gap-5">

        <a
          href="/dashboard"
          class="text-sm font-medium text-gray-600 hover:text-blue-600"
        >
          Inicio
        </a>

        <a
          href="/recetas"
          class="text-sm font-medium text-blue-600"
        >
          Recetas
        </a>

      </div>

    </nav>

  </header>


  <main class="mx-auto max-w-5xl px-6 py-12">

    <a
      href="/recetas"
      class="text-sm font-semibold text-blue-600 hover:text-blue-700"
    >
      ← Volver a recetas
    </a>


    <article
      class="mt-6 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm"
    >

      <% if (receta.imagen_url) { %>

        <img
          src="<%= receta.imagen_url %>"
          alt="<%= receta.nombre %>"
          class="h-96 w-full object-cover"
        />

      <% } %>


      <div class="p-8 md:p-10">

        <div class="flex flex-wrap gap-3">

          <span
            class="rounded-full bg-blue-100 px-4 py-2 text-sm font-medium text-blue-700"
          >
            <%= receta.categoria %>
          </span>


          <% if (receta.dificultad) { %>

            <span
              class="rounded-full bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700"
            >
              <%= receta.dificultad %>
            </span>

          <% } %>


          <% if (receta.tiempo_preparacion) { %>

            <span
              class="rounded-full bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700"
            >
              ⏱ <%= receta.tiempo_preparacion %> minutos
            </span>

          <% } %>

        </div>


        <h1
          class="mt-6 text-4xl font-bold tracking-tight"
        >
          <%= receta.nombre %>
        </h1>


        <p
          class="mt-4 text-lg leading-8 text-gray-600"
        >
          <%= receta.descripcion %>
        </p>


        <div class="mt-10 grid gap-10 md:grid-cols-2">

          <section>

            <h2 class="text-xl font-bold">
              Ingredientes
            </h2>

            <p
              class="mt-4 whitespace-pre-line leading-7 text-gray-600"
            >
              <%= receta.ingredientes %>
            </p>

          </section>


          <section>

            <h2 class="text-xl font-bold">
              Preparación
            </h2>

            <p
              class="mt-4 whitespace-pre-line leading-7 text-gray-600"
            >
              <%= receta.preparacion %>
            </p>

          </section>

        </div>

      </div>

    </article>

  </main>

</body>

</html>