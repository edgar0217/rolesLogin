<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Acceso denegado</title>

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <main class="flex min-h-screen items-center justify-center px-6">
      <div class="w-full max-w-md text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-red-600">
          Error
        </p>

        <h1 class="mt-2 text-7xl font-bold text-gray-900">403</h1>

        <h2 class="mt-4 text-2xl font-semibold">Acceso denegado</h2>

        <p class="mt-3 text-gray-600">
          <%= mensaje || "No tienes permisos para acceder a esta página." %>
        </p>

        <div class="mt-8 flex justify-center gap-3">
          <a
            href="/dashboard"
            class="rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-700"
          >
            Ir al inicio
          </a>

          <a
            href="/logout"
            class="rounded-lg border border-gray-300 bg-white px-5 py-3 text-sm font-medium hover:bg-gray-100"
          >
            Cerrar sesión
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
