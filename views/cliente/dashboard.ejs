<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Cliente</title>

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="min-h-screen bg-gray-50">
    <header class="border-b bg-white">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
      >
        <a href="/cliente" class="text-xl font-bold"> Panel Cliente </a>

        <div class="flex items-center gap-5">
          <a
            href="/dashboard"
            class="text-sm text-gray-600 hover:text-blue-600"
          >
            Dashboard
          </a>

          <a
            href="/logout"
            class="rounded-lg bg-gray-900 px-4 py-2 text-sm text-white"
          >
            Salir
          </a>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <section class="rounded-2xl border bg-white p-8">
        <p class="text-sm font-medium text-blue-600">Cliente</p>

        <h1 class="mt-2 text-3xl font-bold">Hola, <%= user.nombre %></h1>

        <p class="mt-3 text-gray-600">Bienvenido a tu panel de cliente.</p>
      </section>

      <section class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border bg-white p-6">
          <h2 class="font-semibold">Mi perfil</h2>

          <p class="mt-2 text-sm text-gray-500">
            Administra la información de tu cuenta.
          </p>
        </div>

        <div class="rounded-2xl border bg-white p-6">
          <h2 class="font-semibold">Recetas</h2>

          <p class="mt-2 text-sm text-gray-500">
            Consulta las recetas disponibles.
          </p>
        </div>

        <div class="rounded-2xl border bg-white p-6">
          <h2 class="font-semibold">Actividad</h2>

          <p class="mt-2 text-sm text-gray-500">
            Consulta tu actividad reciente.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
