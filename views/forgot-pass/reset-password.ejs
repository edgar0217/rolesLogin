<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    Nueva contraseña | Mi Sistema
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="flex min-h-screen flex-col bg-gray-50 text-gray-900">

  <main class="flex flex-1 items-center justify-center px-6 py-12">

    <section class="w-full max-w-md">

      <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">

        <div class="text-center">

          <span class="inline-block rounded-full bg-green-100 px-4 py-2 text-sm font-medium text-green-700">
            Código verificado
          </span>

          <h1 class="mt-5 text-3xl font-bold tracking-tight">
            Nueva contraseña
          </h1>

          <p class="mt-3 text-sm leading-6 text-gray-600">
            Crea una nueva contraseña para tu cuenta.
          </p>

        </div>


        <% if (error) { %>

        <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <%= error %>
        </div>

        <% } %>


        <form action="/reset-password" method="POST" class="mt-8 space-y-5">

          <div>

            <label for="password" class="block text-sm font-medium text-gray-700">
              Nueva contraseña
            </label>

            <input id="password" name="password" type="password" minlength="8" required placeholder="Mínimo 8 caracteres" class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

          </div>


          <div>

            <label for="confirmPassword" class="block text-sm font-medium text-gray-700">
              Confirmar contraseña
            </label>

            <input id="confirmPassword" name="confirmPassword" type="password" minlength="8" required placeholder="Repite la contraseña" class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

          </div>


          <button type="submit" class="w-full rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
            Cambiar contraseña
          </button>

        </form>

      </div>

    </section>

  </main>

</body>

</html>