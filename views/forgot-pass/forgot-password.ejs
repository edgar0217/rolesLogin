<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    Recuperar contraseña | Mi Sistema
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="flex min-h-screen flex-col bg-gray-50 text-gray-900">
  <header class="border-b border-gray-200 bg-white">

    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">

      <a href="/" class="text-xl font-bold text-gray-900">
        Mi Sistema
      </a>

      <a href="/login" class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-100">
        Iniciar sesión
      </a>

    </nav>

  </header>


  <main class="flex flex-1 items-center justify-center px-6 py-12">

    <section class="w-full max-w-md">

      <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">

        <div class="text-center">

          <span class="inline-block rounded-full bg-blue-100 px-4 py-2 text-sm font-medium text-blue-700">
            Recuperar contraseña
          </span>

          <h1 class="mt-5 text-3xl font-bold tracking-tight">
            ¿Olvidaste tu contraseña?
          </h1>

          <p class="mt-3 text-sm leading-6 text-gray-600">
            Ingresa el correo asociado a tu cuenta
            y te enviaremos un código de verificación.
          </p>

        </div>


        <% if (error) { %>

          <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= error %>
          </div>

          <% } %>


            <form action="/forgot-password" method="POST" class="mt-8 space-y-5">

              <div>

                <label for="email" class="block text-sm font-medium text-gray-700">
                  Correo electrónico
                </label>

                <input id="email" name="email" type="email" required autocomplete="email"
                  placeholder="correo@ejemplo.com" value="<%= typeof email !== 'undefined' ? email : '' %>"
                  class="mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

              </div>


              <button type="submit"
                class="w-full rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Enviar código
              </button>

            </form>


            <div class="mt-8 border-t border-gray-200 pt-6 text-center">

              <a href="/login" class="text-sm font-semibold text-blue-600 hover:text-blue-700">
                Volver al inicio de sesión
              </a>

            </div>

      </div>

    </section>

  </main>

</body>

</html>