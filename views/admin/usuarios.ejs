<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuarios</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-50 text-gray-900">
  <header class="border-b border-gray-200 bg-white">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
      <a href="/admin" class="text-xl font-bold">
        Administración
      </a>

      <div class="flex gap-5">
        <a
          href="/admin"
          class="text-sm font-medium text-gray-600 hover:text-blue-600"
        >
          Dashboard
        </a>

        <a
          href="/logout"
          class="rounded-lg bg-gray-900 px-4 py-2 text-sm text-white hover:bg-gray-700"
        >
          Salir
        </a>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-7xl px-6 py-10">
    <div>
      <p class="text-sm font-semibold text-blue-600">
        Administración
      </p>

      <h1 class="mt-2 text-3xl font-bold">
        Usuarios
      </h1>

      <p class="mt-2 text-gray-500">
        Administra cuentas, roles y estados.
      </p>
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl border border-gray-200 bg-white">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-gray-500">
                Usuario
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-gray-500">
                Correo
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-gray-500">
                Rol
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase text-gray-500">
                Estado
              </th>

              <th class="px-6 py-4 text-right text-xs font-semibold uppercase text-gray-500">
                Acciones
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">
            <% usuarios.forEach(usuario => { %>
              <%
                const esCuentaActual =
                  Number(usuario.id_usuario) === Number(user.id);

                const puedeMostrarse =
                  usuario.rol !== "superadministrador" || esCuentaActual;
              %>

              <% if (puedeMostrarse) { %>
                <tr>
                  <td class="px-6 py-5">
                    <p class="font-medium">
                      <%= usuario.name %>
                    </p>

                    <p class="text-sm text-gray-500">
                      @<%= usuario.username %>
                    </p>
                  </td>

                  <td class="px-6 py-5 text-sm text-gray-600">
                    <%= usuario.email %>
                  </td>

                  <td class="px-6 py-5">
                    <% if (esCuentaActual) { %>
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="rounded-full bg-gray-100 px-3 py-1 text-sm capitalize text-gray-700">
                          <%= usuario.rol %>
                        </span>

                        <% if (usuario.rol === "superadministrador") { %>
                          <span class="rounded-full bg-purple-100 px-2 py-1 text-xs font-semibold text-purple-700">
                            Tu cuenta
                          </span>
                        <% } %>
                      </div>
                    <% } else { %>
                      <form
                        action="/admin/usuarios/<%= usuario.id_usuario %>/rol"
                        method="POST"
                        class="flex items-center gap-2"
                      >
                        <select
                          name="rol"
                          class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm"
                        >
                          <option
                            value="usuario"
                            <%= usuario.rol === "usuario" ? "selected" : "" %>
                          >
                            Usuario
                          </option>

                          <option
                            value="cliente"
                            <%= usuario.rol === "cliente" ? "selected" : "" %>
                          >
                            Cliente
                          </option>

                          <option
                            value="administrador"
                            <%= usuario.rol === "administrador" ? "selected" : "" %>
                          >
                            Administrador
                          </option>

                          <% if (user.rol === "superadministrador") { %>
                            <option value="superadministrador">
                              Superadministrador
                            </option>
                          <% } %>
                        </select>

                        <button
                          type="submit"
                          class="rounded-lg border border-gray-300 px-3 py-2 text-sm hover:bg-gray-50"
                        >
                          Guardar
                        </button>
                      </form>
                    <% } %>
                  </td>

                  <td class="px-6 py-5">
                    <% if (Number(usuario.estado) === 1) { %>
                      <span class="inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">
                        Activo
                      </span>
                    <% } else { %>
                      <span class="inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                        Desactivado
                      </span>
                    <% } %>
                  </td>

                  <td class="px-6 py-5 text-right">
                    <% if (esCuentaActual) { %>
                      <span class="text-sm text-gray-400">
                        Tu cuenta
                      </span>
                    <% } else if (Number(usuario.estado) === 1) { %>
                      <form
                        action="/admin/usuarios/<%= usuario.id_usuario %>/desactivar"
                        method="POST"
                        class="inline"
                        onsubmit="return confirm('¿Deseas desactivar esta cuenta?');"
                      >
                        <button
                          type="submit"
                          class="rounded-lg bg-red-50 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-100"
                        >
                          Desactivar
                        </button>
                      </form>
                    <% } else { %>
                      <form
                        action="/admin/usuarios/<%= usuario.id_usuario %>/activar"
                        method="POST"
                        class="inline"
                      >
                        <button
                          type="submit"
                          class="rounded-lg bg-green-50 px-4 py-2 text-sm font-medium text-green-700 hover:bg-green-100"
                        >
                          Reactivar
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>