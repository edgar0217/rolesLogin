<!DOCTYPE html>
<html lang="es">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Administrador</title>

  <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="min-h-screen bg-gray-50 text-gray-900">

<header
  class="border-b border-gray-200 bg-white"
>

  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4"
  >

    <a
      href="/admin"
      class="text-xl font-bold"
    >
      Administración
    </a>

    <div class="flex items-center gap-6">

      <a
        href="/admin/usuarios"
        class="text-sm font-medium text-gray-600 hover:text-blue-600"
      >
        Usuarios
      </a>

      <a
        href="/dashboard"
        class="text-sm font-medium text-gray-600 hover:text-blue-600"
      >
        Recetas
      </a>

      <% if (
        user.rol === "superadministrador"
      ) { %>

        <a
          href="/superadmin"
          class="text-sm font-medium text-gray-600 hover:text-blue-600"
        >
          Superadmin
        </a>

      <% } %>

      <a
        href="/logout"
        class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white"
      >
        Salir
      </a>

    </div>

  </nav>

</header>


<main
  class="mx-auto max-w-7xl px-6 py-10"
>

  <section>

    <p
      class="text-sm font-semibold text-blue-600"
    >
      Administración
    </p>

    <h1
      class="mt-2 text-3xl font-bold"
    >
      Hola, <%= user.nombre %>
    </h1>

    <p
      class="mt-2 text-gray-600"
    >
      Desde aquí puedes administrar el sistema.
    </p>

  </section>


  <section
    class="mt-8 grid gap-6 md:grid-cols-3"
  >

    <a
      href="/admin/usuarios"
      class="rounded-2xl border border-gray-200 bg-white p-6 transition hover:border-gray-400"
    >

      <h2
        class="text-lg font-semibold"
      >
        Usuarios
      </h2>

      <p
        class="mt-2 text-sm text-gray-500"
      >
        Gestiona usuarios, roles y estados.
      </p>

    </a>


    <a
      href="/dashboard"
      class="rounded-2xl border border-gray-200 bg-white p-6 transition hover:border-gray-400"
    >

      <h2
        class="text-lg font-semibold"
      >
        Recetas
      </h2>

      <p
        class="mt-2 text-sm text-gray-500"
      >
        Consulta las recetas registradas.
      </p>

    </a>


    <div
      class="rounded-2xl border border-gray-200 bg-white p-6"
    >

      <h2
        class="text-lg font-semibold"
      >
        Mi cuenta
      </h2>

      <p
        class="mt-2 text-sm text-gray-500"
      >
        <%= user.correo %>
      </p>

      <p
        class="mt-2 text-sm font-medium"
      >
        <%= user.rol %>
      </p>

    </div>

  </section>

</main>

</body>
</html>